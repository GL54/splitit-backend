PORT=3000
NODE_ENV=development
DATABASE_URL="file:./dev.db"

# Auth0 Configuration (optional in dev, fallback dev auth enabled if unset)
AUTH0_DOMAIN="the-fool.us.auth0.com"
AUTH0_AUDIENCE="https://the-fool.us.auth0.com/api/v2/"

# UPI Verification Provider: "sandbox" | "cashfree" | "razorpay"
UPI_VERIFICATION_PROVIDER=sandbox

# Cashfree API Credentials (if using live Cashfree provider)
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV=TEST
